# Copy to .env (git-ignored) for local development. In production set these as
# real environment variables / your host's secret manager instead of a file.

# development | production
APP_ENV=development

# REQUIRED in production (min 32 characters). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# In development, if empty, a random key is generated and stored in instance/.
SECRET_KEY=
