# ---------------------------------------------------------------------------
# FoodShare database switch.
#
# Copy this file to database/db.env (git-ignored) to customise it, then
# restart the app. Without db.env the defaults below (SQLite) are used.
#
# DB_ENGINE options:
#   sqlite      -> zero setup, file stored in database/data/   (default)
#   mysql       -> MySQL 8.0.16+/MariaDB 10.2+ + `pip install PyMySQL`
#   postgresql  -> PostgreSQL + `pip install psycopg2-binary`
#
# Tables are created automatically on startup. Create the empty database
# first for MySQL/PostgreSQL, e.g.
#   MySQL:       CREATE DATABASE foodshare CHARACTER SET utf8mb4;
#   PostgreSQL:  CREATE DATABASE foodshare;
#
# NEVER commit db.env: it can contain your database password.
# ---------------------------------------------------------------------------
DB_ENGINE=sqlite

# --- SQLite settings ---
SQLITE_FILE=foodshare.db

# --- MySQL / PostgreSQL settings (ignored for sqlite) ---
DB_HOST=localhost
# Leave DB_PORT empty to use the default (3306 for MySQL, 5432 for PostgreSQL)
DB_PORT=
DB_NAME=foodshare
DB_USER=foodshare_app
DB_PASSWORD=

# --- Demo data ---
# Creates demo donors/NGOs/listings (password "demo1234") when the database is
# empty. DEVELOPMENT ONLY: ignored automatically when APP_ENV=production.
SEED_DEMO=true
